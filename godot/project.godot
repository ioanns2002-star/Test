; Engine configuration file.
; Edit through the Godot editor when possible.
;
; The Compatibility renderer keeps this viewer usable on integrated and older GPUs.

config_version=5

[application]

config/name="Rain Gallery — Godot Viewer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

; The source camera manifest uses a 1.4 aspect ratio (735 × 525 reference).
window/size/viewport_width=1400
window/size/viewport_height=1000
window/size/window_width_override=1120
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
